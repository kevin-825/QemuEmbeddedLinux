{
  "project_name": "QemuEmbeddedLinux",
  "project_version": "0.1.0",
  "environment": {
    "BUILDROOT_DIR": "${PROJECT_ROOT}/buildroot",
    "EXTERNAL_DIR": "${PROJECT_ROOT}/external",
    "OUTPUT_BASE_DIR": "/mnt/wsl/ramdisk5/out",
    "LOCAL_SRC_BASE": "${PROJECT_ROOT}/local_src",
    "GLOBAL_DL_DIR": "${PROJECT_ROOT}/shared/buildroot_downloads",
    "GLOBAL_CCACHE_DIR": "${PROJECT_ROOT}/shared/buildroot_ccache",
    "TFTP_SERVER_DIR": "/var/lib/tftpboot",
    "DOCKER_WRAPPER": "docker run --rm -v ${PROJECT_ROOT}:${PROJECT_ROOT} $dockerVolumes -w ${PROJECT_ROOT} ${DOCKER_IMAGE}"
  },
  "targets": {
    "qemu_riscv64_virt_board": {
      "ARCH_NAME": "riscv64",
      "BOARD_NAME": "qemu_riscv64_virt",
      "BOARD_TYPE": "qemu",
      "HOST_TOOLCHAIN_PATH": "/mnt/wsl/vhd0/opt/riscv/glibc/riscv/bin/riscv64-unknown-linux-gnu",
      "ACTIVE_DEFCONFIG": "my_qemu_riscv64_virt_defconfig",
      "DOCKER_IMAGE": "kflyn825/rvdev:latest",
      "rootfsOnly_BR2_OPT": [
      ]
      
    },
    "qemu_aarch64_virt_board": {
      "ARCH_NAME": "aarch64",
      "BOARD_NAME": "qemu_aarch64_virt",
      "BOARD_TYPE": "qemu",
      "HOST_TOOLCHAIN_PATH": "/mnt/wsl/vhd0/opt/arm/arm_toolchains/aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu",
      "ACTIVE_DEFCONFIG": "my_qemu_aarch64_virt_defconfig",
      "DOCKER_IMAGE": "kflyn825/arm_dev_u24:latest",
      "rootfsOnly_BR2_OPT": [
        "BR2_TARGET_OPTEE_OS=n",
        "BR2_TARGET_ARM_TRUSTED_FIRMWARE=n"
      ]
    },
    "qemu_aarch64_raspberrypi3_board": {
      "ARCH_NAME": "aarch64",
      "BOARD_NAME": "qemu_aarch64_raspi3",
      "BOARD_TYPE": "qemu",
      "HOST_TOOLCHAIN_PATH": "/mnt/wsl/vhd0/opt/arm/arm_toolchains/aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu",
      "ACTIVE_DEFCONFIG": "my_qemu_aarch64_raspi3_defconfig",
      "DOCKER_IMAGE": "kflyn825/arm_dev_u24:latest"
    }
  },
  "build": {
    "output_dir": "${OUTPUT_BASE_DIR}/${TARGET_BOARD}/${BUILD_PROFILE}",
    "overlay_dir": "${LOCAL_SRC_BASE}/overlays/${TARGET_BOARD}/${BUILD_PROFILE}",
    "base_options": [
      "-C ${BUILDROOT_DIR}",
      "O=${OUTPUT_BASE_DIR}/${output_subdir}",
      "BR2_EXTERNAL=${EXTERNAL_DIR}",
      "BR2_DL_DIR=${GLOBAL_DL_DIR}",
      "BR2_CCACHE_DIR=${GLOBAL_CCACHE_DIR}",
      "BR2_ROOTFS_OVERLAY=${overlay_dir}",
      "-j$(nproc)"
    ],
    "rootfsOnlyBuild": {
      "env_exports": {},
      "build_options": [
        "BR2_LINUX_KERNEL=n",
        "BR2_TARGET_UBOOT=n",
        "${targets.${TARGET_BOARD}.rootfsOnly_BR2_OPT.join('    ')}"
        
      ],
      "overrides": {
        "CUSTOM_SENSOR_MOD": "${LOCAL_SRC_BASE}/drivers/custom_sensor_mod",
        "PROPRIETARY_APP": "${LOCAL_SRC_BASE}/apps/my_custom_daemon"
      },
      "pre_cmds": [
        "mkdir -p ${LOCAL_SRC_BASE}/overlays/${TARGET_BOARD}/${BUILD_PROFILE}"
      ],
      "build_cmds": [
        "${DOCKER_WRAPPER} make ${build.base_options.join('    ')} ${ACTIVE_DEFCONFIG}",
        "${DOCKER_WRAPPER} make ${build.base_options.join('    ')} ${build.build_options.join('    ')} all"
      ],
      "post_cmds": [
        "echo 'Rootfs generation complete. Artifacts located in ${OUTPUT_BASE_DIR}/${output_subdir}/images/'"
      ],
      "kernel_image": "${OUTPUT_BASE_DIR}/${output_subdir}/images/zImage",
      "rootfs_image": "${OUTPUT_BASE_DIR}/${output_subdir}/images/rootfs.ext4",
      "dtb_image": " ",
      "qemu_run_cmd": "./run_qemu.sh $qemu_arch ${kernel_image} ${rootfs_image} ${dtb_image}"
    },
    "customBuild": {
      "output_subdir": "${TARGET_BOARD}_custom_build",
      "env_exports": {
        "FIRMWARE_VERSION": "1.0.4-dev",
        "DEBUG_DRIVER_TRACE": "1"
      },
      "build_options": [
        "V=1",
        "BR2_ROOTFS_OVERLAY=${LOCAL_SRC_BASE}/overlays/${TARGET_BOARD}_rootfs_overlay"
      ],
      "overrides": {
        "UBOOT": "${LOCAL_SRC_BASE}/u-boot-${ARCH_NAME}",
        "LINUX": "${LOCAL_SRC_BASE}/linux-${ARCH_NAME}",
        "CUSTOM_SENSOR_MOD": "${LOCAL_SRC_BASE}/drivers/custom_sensor_mod",
        "PROPRIETARY_APP": "${LOCAL_SRC_BASE}/apps/my_custom_daemon"
      },
      "pre_cmds": [
        "./scripts/pre_build.sh"
      ],
      "build_cmds": [
        "${DOCKER_WRAPPER} make ${build.base_options[].join('    ')} ${ACTIVE_DEFCONFIG}",
        "${DOCKER_WRAPPER} make ${build.base_options[].join('    ')} ${build.build_options[].join('    ')} uboot-rebuild",
        "${DOCKER_WRAPPER} make ${build.base_options[].join('    ')} ${build.build_options[].join('    ')} linux-rebuild",
        "${DOCKER_WRAPPER} make ${build.base_options[].join('    ')} ${build.build_options[].join('    ')} custom_sensor_mod-rebuild",
        "${DOCKER_WRAPPER} make ${build.base_options[].join('    ')} ${build.build_options[].join('    ')} proprietary_app-rebuild",
        "${DOCKER_WRAPPER} make ${build.base_options[].join('    ')} ${build.build_options[].join('    ')} all"
      ],
      "post_cmds": [
        "./scripts/post_build.sh"
      ]
    }
  }
}