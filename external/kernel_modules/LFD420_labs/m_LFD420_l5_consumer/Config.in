config BR2_PACKAGE_M_LFD420_L5_CONSUMER
	bool "m_LFD420_l5_consumer"
	depends on BR2_LINUX_KERNEL
	default y if BR2_EXTERNAL_KMODE_DEV_ALL
	help
	  Enterprise out-of-tree kernel module and platform driver for m_LFD420_l5_consumer.

if BR2_PACKAGE_M_LFD420_L5_CONSUMER

config BR2_PACKAGE_M_LFD420_L5_CONSUMER_DEBUG
	bool "Enable Debug Mode for m_LFD420_l5_consumer"
	help
	  Select this to compile the module with debug flags enabled.
	  This will link debug.o and enable extra kernel logging.

endif
