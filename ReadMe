
to build linux kernel only:

./kbuild.sh -b qemu_riscv64_virt_board -d defconfig
./kbuild.sh -b qemu_aarch64_virt_board -d defconfig
./kbuild.sh -b qemu_aarch64_virt_board -d defconfig -s my_linux_DEBUG_defconfig


./kbuild.sh -b qemu_riscv64_virt_board -d my_linux_defconfig -m -s my_linux_DEBUG_defconfig
./kbuild.sh -b qemu_riscv64_virt_board -d my_linux_DEBUG_defconfig -m -s 

./kbuild.sh -b qemu_aarch64_virt_board -c -d my_linux_arm64_virt_DEBUG_defconfig  -m -s  -p rootfsOnlyBuild


to configure buildroot:
./setup_defconfig.sh -b qemu_aarch64_virt_board  -c -m -s -ld rootfsOnlyBuild_qemu_aarch64_virt_defconfig
./setup_defconfig.sh -b qemu_aarch64_virt_board  -c -m -s -ld customBuild_qemu_aarch64_virt_defconfig

./setup_defconfig.sh -b qemu_riscv64_virt_board  -c -m -s -ld rootfsOnlyBuild_qemu_riscv64_virt_defconfig
./setup_defconfig.sh -b qemu_riscv64_virt_board  -c -m -s -ld customBuild_qemu_riscv64_virt_defconfig



find /mnt/wsl/ramdisk5/out/qemu_riscv64_virt_board/customBuild/build/ -name ".stamp_images_installed" -delete



to build using builtroot:

./build.sh -b qemu_riscv64_virt_board -p rootfsOnlyBuild
./build.sh -b qemu_riscv64_virt_board -p customBuild

./build.sh -b qemu_aarch64_virt_board -p rootfsOnlyBuild
./build.sh -b qemu_aarch64_virt_board -p customBuild


./build.sh -b qemu_riscv64_virt_board -p rootfsOnlyBuild -r -s -S
./build.sh -b qemu_riscv64_virt_board -p rootfsOnlyBuild -ro -s -S