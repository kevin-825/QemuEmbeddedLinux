{
  "project_name": "QemuEmbeddedLinux",
  "project_version": "0.1.0",
  "environment": {
    "BUILDROOT_DIR": "${PROJECT_ROOT}/buildroot",
    "EXTERNAL_DIR": "${PROJECT_ROOT}/external",
    "OUTPUT_BASE_DIR": "/mnt/wsl/ramdisk5/out",
    "LOCAL_SRC_BASE": "${PROJECT_ROOT}/local_src",
    "GLOBAL_DL_DIR": "${PROJECT_ROOT}/shared/buildroot_downloads",
    "GLOBAL_CCACHE_DIR": "/mnt/wsl/disk2/.br2_local_out/buildroot_ccache",
    "GLOBAL_HOST_DIR": "/mnt/wsl/disk2/.br2_local_out/host",
    "BASE_DOCKER_CMD": "docker run -it -e TERM=${TERM} --rm -v ${PROJECT_ROOT}:${PROJECT_ROOT} ${dockerVolumes} -w ${PROJECT_ROOT} ",
    "DOCKER_WRAPPER": "${BASE_DOCKER_CMD} ${targets.${TARGET_BOARD}.DOCKER_IMAGE}"
  },
  "targets": {
    "qemu_riscv64_virt_board": {
      "ARCH": "riscv",
      "ARCH_SIZE": "64",
      "BOARD_NAME": "qemu_riscv64_virt",
      "BOARD_TYPE": "qemu",
      "HOST_TOOLCHAIN_PREFIX": "riscv64-unknown-linux-gnu",
      "HOST_TOOLCHAIN_PATH": "/mnt/wsl/vhd0/opt/riscv/glibc/riscv",
      "BR_DEFCONFIG": "my_qemu_riscv64_virt_defconfig",
      "KERNEL_DEFCONFIG": "my_linux_DEBUG_defconfig",
      "DOCKER_IMAGE": "kflyn825/rvdev:latest",
      "rootfsOnly_BR2_OPT": []
    },
    "qemu_aarch64_virt_board": {
      "ARCH": "arm64",
      "ARCH_SIZE": "64",
      "BOARD_NAME": "qemu_aarch64_virt",
      "BOARD_TYPE": "qemu",
      "HOST_TOOLCHAIN_PREFIX": "aarch64-none-linux-gnu",
      "HOST_TOOLCHAIN_PATH": "/mnt/wsl/vhd0/opt/arm/arm_toolchains/aarch64-none-linux-gnu",
      "BR_DEFCONFIG": "my_qemu_aarch64_virt_defconfig",
      "KERNEL_DEFCONFIG": "my_linux_arm64_virt_DEBUG_defconfig",
      "DOCKER_IMAGE": "kflyn825/arm_dev_u24:latest",
      "rootfsOnly_BR2_OPT": [
        "BR2_TARGET_OPTEE_OS=n",
        "BR2_TARGET_ARM_TRUSTED_FIRMWARE=n"
      ]
    },
    "qemu_raspi4b_board": {
      "ARCH": "arm64",
      "ARCH_SIZE": "64",
      "BOARD_NAME": "qemu_raspi4b",
      "BOARD_TYPE": "qemu",
      "HOST_TOOLCHAIN_PREFIX": "aarch64-none-linux-gnu",
      "HOST_TOOLCHAIN_PATH": "/mnt/wsl/vhd0/opt/arm/arm_toolchains/aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu",
      "BR_DEFCONFIG": "my_qemu_aarch64_raspi4_defconfig",
      "KERNEL_DEFCONFIG": "my_linux_qemu_raspi4b_DEBUG_defconfig",
      "DOCKER_IMAGE": "kflyn825/arm_dev_u24:latest",
      "rootfsOnly_BR2_OPT": []
    },
    "qemu_SiFive_HiFive_Unleashed_board": {
      "ARCH": "riscv",
      "ARCH_SIZE": "64",
      "BOARD_NAME": "qemu_SiFive_HiFive_Unleashed",
      "BOARD_TYPE": "qemu",
      "HOST_TOOLCHAIN_PREFIX": "riscv64-linux-gnu",
      "HOST_TOOLCHAIN_PATH": "not_confgiured",
      "BR_DEFCONFIG": "my_qemu_HiFive_Unleashed_defconfig",
      "KERNEL_DEFCONFIG": "my_linux_HiFive_Unleashed_DEBUG_defconfig",
      "DOCKER_IMAGE": "kflyn825/rvdev:latest",
      "rootfsOnly_BR2_OPT": []
    }
  },
  "build": {
    "output_dir": "${OUTPUT_BASE_DIR}/${TARGET_BOARD}/${BUILD_PROFILE}",
    "overlays_dir": "${EXTERNAL_DIR}/board/${TARGET_BOARD}/overlay",
    "overrides": {
      "ATF": "/mnt/wsl/disk2/OffRepos/atf-mainline",
      "OPENSBI": "/mnt/wsl/disk2/OffRepos/opensbi",
      "UBOOT": "/mnt/wsl/disk2/OffRepos/u-boot",
      "LINUX": "/mnt/wsl/ramdisk5/linux"
    },
    "env_exports": [
      "ARCH=${targets.${TARGET_BOARD}.ARCH}",
      "CROSS_COMPILE=${targets.${TARGET_BOARD}.HOST_TOOLCHAIN_PREFIX}-",
      "KERNEL_SRC_PATH=/mnt/wsl/ramdisk5/linux",
      "PRE_BUILT_KERNEL_IMAGE=${OUTPUT_BASE_DIR}/${TARGET_BOARD}/kernel/${targets.${TARGET_BOARD}.KERNEL_DEFCONFIG}/arch/${targets.${TARGET_BOARD}.ARCH}/boot/Image"
    ],
    "base_options": [
      "-C ${BUILDROOT_DIR}",
      "O=${output_dir}",
      "BR2_EXTERNAL=${EXTERNAL_DIR}",
      "BR2_DL_DIR=${GLOBAL_DL_DIR}",
      "BR2_CCACHE=y",
      "BR2_CCACHE_DIR=${GLOBAL_CCACHE_DIR}",
      "BR2_HOST_DIR=${GLOBAL_HOST_DIR}",
      "BR2_TOOLCHAIN_EXTERNAL_PATH=${targets.${TARGET_BOARD}.HOST_TOOLCHAIN_PATH}",
      "BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX=${targets.${TARGET_BOARD}.HOST_TOOLCHAIN_PREFIX}",
      "BR2_ROOTFS_POST_IMAGE_SCRIPT=${EXTERNAL_DIR}/board/${TARGET_BOARD}/post-image.sh",
      "BR2_ROOTFS_OVERLAY=${overlays_dir}",
      "-j $(expr $(nproc) + 1)"
    ],
    "profiles": {
      "rootfsOnlyBuild": {
        "DOCKER_CMD_OPT": "-e PRE_BUILT_KERNEL_IMAGE=${PRE_BUILT_KERNEL_IMAGE}",
        "DOCKER_CMD": "${BASE_DOCKER_CMD} ${rootfsOnlyBuild.DOCKER_CMD_OPT} ${targets.${TARGET_BOARD}.DOCKER_IMAGE}",
        "build_options": [
          "BR2_LINUX_KERNEL=n",
          "BR2_TARGET_UBOOT=n",
          "${targets.${TARGET_BOARD}.rootfsOnly_BR2_OPT.join('    ')}"
        ],
        "pre_cmds": [
          "mkdir -p ${build.overlays_dir}",
          "rsync -av --delete --exclude='.git/'  \"/mnt/wsl/disk2/OffRepos/linux\"  \"/mnt/wsl/ramdisk5\"",
          "./kbuild.sh -b ${TARGET_BOARD} -p 'rootfsOnlyBuild' "
        ],
        "build_cmds": [
          "${rootfsOnlyBuild.DOCKER_CMD} make ${build.base_options.join('    ')} ${TARGET_BR2_DEFCONFIG}",
          "${rootfsOnlyBuild.DOCKER_CMD} make ${build.base_options.join('    ')} ${build.build_options.join('    ')} all"
        ],
        "post_cmds": [
          "echo 'Rootfs generation complete. Artifacts located in ${output_dir}/images/'"
        ],
        "qemu_run_cmd": "${rootfsOnlyBuild.DOCKER_CMD} ${EXTERNAL_DIR}/board/${TARGET_BOARD}/run_qemu.sh ${output_dir}/images/u-boot ${output_dir}/images/sdcard.img "
      },
      "customBuild": {
        "DOCKER_CMD_OPT": " ",
        "DOCKER_CMD": "${BASE_DOCKER_CMD} ${customBuild.DOCKER_CMD_OPT} ${targets.${TARGET_BOARD}.DOCKER_IMAGE}",
        "build_options": [
          "BR2_ROOTFS_OVERLAY=${LOCAL_SRC_BASE}/overlays/${TARGET_BOARD}_rootfs_overlay",
          "BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE=\"${EXTERNAL_DIR}/board/${TARGET_BOARD}/kernel_configs/${targets.${TARGET_BOARD}.KERNEL_DEFCONFIG}\""
        ],
        "pre_cmds": [
          "./scripts/pre_build.sh"
        ],
        "build_cmds": [
          "${customBuild.DOCKER_CMD} make ${build.base_options.join('    ')} ${BR_DEFCONFIG}",
          "${customBuild.DOCKER_CMD} make ${build.base_options.join('    ')} ${build.build_options.join('    ')} uboot-rebuild",
          "${customBuild.DOCKER_CMD} make ${build.base_options.join('    ')} ${build.build_options.join('    ')} linux-rebuild",
          "${customBuild.DOCKER_CMD} make ${build.base_options.join('    ')} ${build.build_options.join('    ')} custom_sensor_mod-rebuild",
          "${customBuild.DOCKER_CMD} make ${build.base_options.join('    ')} ${build.build_options.join('    ')} proprietary_app-rebuild",
          "${customBuild.DOCKER_CMD} make ${build.base_options.join('    ')} ${build.build_options.join('    ')} all"
        ],
        "post_cmds": [
          "./scripts/post_build.sh"
        ]
      }
    }
  }
}