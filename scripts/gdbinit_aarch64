# 1. Load Static Toolkits (The paths assume this file is in your project root)
shell pwd
add-auto-load-safe-path /mnt/wsl/ramdisk5/linux/scripts/gdb/vmlinux-gdb.py
source ./scripts/gdb_helper/global_setup.gdb
source ./scripts/gdb_helper/linux_macros.gdb
#source ./scripts/gdb_helper/arch_riscv64.gdb
source ./scripts/gdb_helper/arch_arm64.gdb

# 2. Connect to the Target


define rl
    # Reloads the root playbook dynamically
    source ./gdbinit
    echo [\n] Dynamic Playbook Reloaded!\n
end


# --- Binary Loading ---
set $out_dir = "/mnt/wsl/ramdisk5/out"
eval "set $riscv64_virt = \"%s/qemu_riscv64_virt_board\"", $out_dir
eval "set $aarch64_virt = \"%s/qemu_aarch64_virt_board\"", $out_dir

#eval "set $riscv64_virt_vmlinux = \"%s/kernel/my_linux_DEBUG_defconfig/vmlinux\"", $riscv64_virt
eval "set $rv_prog0 = \"%s/kernel/my_linux_DEBUG_defconfig/vmlinux\"", $riscv64_virt

#eval "set $aarch64_virt_vmlinux = \"%s/kernel/my_linux_arm64_virt_DEBUG_defconfig/vmlinux\"", $aarch64_virt
eval "set $arm_prog0 = \"%s/kernel/my_linux_arm64_virt_DEBUG_defconfig/vmlinux\"", $aarch64_virt

define cn
    echo [\n] Connecting to QEMU on localhost:1234...\n
    target remote localhost:1234
    
    # Reload symbols just in case the binary was updated
    # add-symbol-file vmlinux
    
    
    info connections
end



eval "add-symbol-file %s", $arm_prog0
cn



# 3. Dynamic State & Breakpoints

hbreak start_kernel
hbreak panic


