config BR2_PACKAGE_M_HELLOMOD
	bool "m_HelloMod"
	depends on BR2_LINUX_KERNEL
	default y if BR2_EXTERNAL_KMODE_DEV_ALL
	help
	  Enterprise out-of-tree kernel module and platform driver for m_HelloMod.

if BR2_PACKAGE_M_HELLOMOD

config BR2_PACKAGE_M_HELLOMOD_DEBUG
	bool "Enable Debug Mode for m_HelloMod"
	help
	  Select this to compile the module with debug flags enabled.
	  This will link debug.o and enable extra kernel logging.

endif
