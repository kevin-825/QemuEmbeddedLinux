config BR2_PACKAGE_M_LFD420_L0_PRIMITIVE
	bool "m_LFD420_l0_primitive"
	depends on BR2_LINUX_KERNEL
	default y if BR2_EXTERNAL_KMODE_DEV_ALL
	help
	  Enterprise out-of-tree kernel module and platform driver for m_LFD420_l0_primitive.

if BR2_PACKAGE_M_LFD420_L0_PRIMITIVE

config BR2_PACKAGE_M_LFD420_L0_PRIMITIVE_DEBUG
	bool "Enable Debug Mode for m_LFD420_l0_primitive"
	help
	  Select this to compile the module with debug flags enabled.
	  This will link debug.o and enable extra kernel logging.

