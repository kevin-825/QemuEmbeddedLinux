config BR2_PACKAGE_M_LFD420_L5_PRODUCER
	bool "m_LFD420_l5_producer"
	depends on BR2_LINUX_KERNEL
	default y if BR2_EXTERNAL_KMODE_DEV_ALL
	help
	  Enterprise out-of-tree kernel module and platform driver for m_LFD420_l5_producer.

if BR2_PACKAGE_M_LFD420_L5_PRODUCER

config BR2_PACKAGE_M_LFD420_L5_PRODUCER_DEBUG
	bool "Enable Debug Mode for m_LFD420_l5_producer"
	help
	  Select this to compile the module with debug flags enabled.
	  This will link debug.o and enable extra kernel logging.

