
to build linux kernel only:

./kbuild.sh -b qemu_riscv64_virt_board -d defconfig
./kbuild.sh -b qemu_aarch64_virt_board -d defconfig
./kbuild.sh -b qemu_aarch64_virt_board -d defconfig -s my_linux_DEBUG_defconfig


./kbuild.sh -b qemu_riscv64_virt_board -d my_linux_defconfig -m -s my_linux_DEBUG_defconfig
./kbuild.sh -b qemu_riscv64_virt_board -d my_linux_DEBUG_defconfig -m -s 

./kbuild.sh -b qemu_aarch64_virt_board -c -d my_linux_arm64_virt_DEBUG_defconfig  -m -s  -p rootfsOnlyBuild


to configure buildroot:
./setup_defconfig.sh -b qemu_aarch64_virt_board  -c -m -s -ld rootfsOnlyBuild_qemu_aarch64_virt_defconfig
./setup_defconfig.sh -b qemu_aarch64_virt_board  -c -m -s -ld customBuild_qemu_aarch64_virt_defconfig

./setup_defconfig.sh -b qemu_riscv64_virt_board  -c -m -s -ld rootfsOnlyBuild_qemu_riscv64_virt_defconfig
./setup_defconfig.sh -b qemu_riscv64_virt_board  -c -m -s -ld customBuild_qemu_riscv64_virt_defconfig



find /mnt/wsl/ramdisk5/out/qemu_riscv64_virt_board/customBuild/build/ -name ".stamp_images_installed" -delete



to build using builtroot:


./build.sh -b qemu_aarch64_virt_board -p rootfsOnlyBuild -k
./build.sh -b qemu_aarch64_virt_board -p rootfsOnlyBuild -r -s -S

./build.sh -b qemu_riscv64_virt_board -p rootfsOnlyBuild -k
./build.sh -b qemu_riscv64_virt_board -p rootfsOnlyBuild -ro -s -S




./build.sh -b qemu_aarch64_virt_board -p customBuild
./build.sh -b qemu_aarch64_virt_board -p customBuild -ro -s -S

./build.sh -b qemu_riscv64_virt_board -p customBuild
./build.sh -b qemu_riscv64_virt_board -p customBuild -ro -s -S




kmake dock:
./kmake kernelversion
ARCH=riscv CROSS_COMPILE=riscv64-unknown-linux-gnu- ./kmake kernelversion


./kmake ARCH=riscv CROSS_COMPILE=riscv64-unknown-linux-gnu-  mKCONFIG_ALLCONFIG='"arch/riscv/configs/defconfig arch/riscv/configs/64-bit.config"' allnoconfig
./kmake ARCH=riscv CROSS_COMPILE=riscv64-unknown-linux-gnu-  nconfig

./kmake ARCH=riscv CROSS_COMPILE=riscv64-unknown-linux-gnu- 


cp /mnt/wsl/ramdisk5/QemuEmbeddedLinux/external/board/qemu_riscv64_virt_board/kernel_configs/riscv_virt_minimal_defconfig 

./kmake ARCH=riscv CROSS_COMPILE=riscv64-unknown-linux-gnu- olddefconfig

mkdir -p /mnt/wsl/ramdisk5/kbuild_out/riscv

cp ./external/board/qemu_riscv64_virt_board/kernel_configs/riscv_virt_minimal_DEBUG_defconfig /mnt/wsl/ramdisk5/kbuild_out/riscv/.config











# to remove a file from .git :
git filter-repo --path <PATH_TO_DELETE> --invert-paths --force
git remote add origin git@github.com:kevin-825/QemuEmbeddedLinux.git
git push origin --force --all
