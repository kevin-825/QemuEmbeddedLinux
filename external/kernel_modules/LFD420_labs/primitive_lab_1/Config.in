config BR2_PACKAGE_PRIMITIVE_LAB_1
	bool "primitive_lab_1"
	depends on BR2_LINUX_KERNEL
	default y if BR2_EXTERNAL_KMODE_DEV_ALL
	help
	  Enterprise out-of-tree kernel module and platform driver for primitive_lab_1.

if BR2_PACKAGE_PRIMITIVE_LAB_1

config BR2_PACKAGE_PRIMITIVE_LAB_1_DEBUG
	bool "Enable Debug Mode for primitive_lab_1"
	help
	  Select this to compile the module with debug flags enabled.
	  This will link debug.o and enable extra kernel logging.

endif
