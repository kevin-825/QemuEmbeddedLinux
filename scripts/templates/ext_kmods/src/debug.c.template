#include <linux/module.h>
#include <linux/debugfs.h>
#include "${mod_name}_debug.h"

/* * The root directory for our module in /sys/kernel/debug/
 */
static struct dentry *${mod_name}_debug_dir;

/* * Live variables we want to expose to the terminal 
 */
u32 ${mod_name}_debug_hit_count = 0;
u32 ${mod_name}_simulated_fault = 0;

void ${mod_name}_debug_init(void)
{
    /* 1. Create the root folder: /sys/kernel/debug/${mod_name}/ */
    ${mod_name}_debug_dir = debugfs_create_dir("${mod_name}", NULL);
    
    if (!${mod_name}_debug_dir) {
        pr_err("[%s] Failed to create debugfs directory.\n", KBUILD_MODNAME);
        return;
    }

    /* 2. Create a Read-Only file to track how many times a function is hit */
    debugfs_create_u32("hit_count", 0444, ${mod_name}_debug_dir, &${mod_name}_debug_hit_count);

    /* 3. Create a Read/Write file to let us manually trigger faults via bash */
    debugfs_create_u32("simulate_fault", 0644, ${mod_name}_debug_dir, &${mod_name}_simulated_fault);

    ${upper}_DBG("Debug subsystem and debugfs initialized.\n");
}

void ${mod_name}_debug_cleanup(void)
{
    /* * debugfs_remove_recursive safely destroys the folder and all 
     * files inside it in one shot. 
     */
    debugfs_remove_recursive(${mod_name}_debug_dir);
    
    pr_info("[%s:debug] Debug subsystem offline.\n", KBUILD_MODNAME);
}
