
to build linux kernel only:

./kbuild.sh -b qemu_riscv64_virt_board -d defconfig
./kbuild.sh -b qemu_aarch64_virt_board -d defconfig
./kbuild.sh -b qemu_aarch64_virt_board -d defconfig -s my_linux_DEBUG_defconfig


./kbuild.sh -b qemu_riscv64_virt_board -d ./external/board/qemu_riscv64_virt_board/my_linux_defconfig -m -s my_linux_DEBUG_defconfig


./kbuild.sh -b qemu_aarch64_virt_board -d ./external/board/qemu_aarch64_virt_board/kernel_configs/my_linux_DEBUG_defconfig -m -s  -p rootfsOnlyBuild





to build using builtroot:

./build.sh -b qemu_riscv64_virt_board -p rootfsOnlyBuild
./build.sh -b qemu_riscv64_virt_board -p customBuild

./build.sh -b qemu_aarch64_virt_board -p rootfsOnlyBuild
./build.sh -b qemu_aarch64_virt_board -p customBuild