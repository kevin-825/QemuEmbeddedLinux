################################
# Breakpoint & and debug setup
################################


define cnnt
    echo \n ====== Connecting to QEMU on localhost:1234 ======\n
    target remote localhost:1234
    info connections
    echo \n =============== Connected ========================\n
end

define cnnt-ext
    echo \n ====== Connecting to QEMU on localhost:1234 ======\n
    target extended-remote localhost:1234
    info connections
    echo \n =============== Connected ========================\n
    #set remote exec-file /usr/bin/my_custom_app
end

define bkpt
    echo \n-------------------------------\n
    hbreak start_kernel
    hbreak panic
    echo \n-------------------------------\n
end

printf "archsize%s_%s-stop-hook  added to hook-stop", $build_ARCH_SIZE, $build_ARCH

define hook-stop
    eval "archsize%s_%s-stop-hook", $build_ARCH_SIZE, $build_ARCH
end

#Do the connection and do setup breakpoint here
#cnnt
cnnt-ext
bkpt
