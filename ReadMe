
1.to modify a defconfig :

step1:   load defconfig (Initialize the .config)
make -C ./buildroot \
  O=/mnt/wsl/ramdisk5/out/config_workspace \
  BR2_EXTERNAL=$(pwd)/external \
  my_qemu_riscv64_virt_defconfig

step2: edit

make -C ./buildroot \
  O=/mnt/wsl/ramdisk5/out/config_workspace \
  BR2_EXTERNAL=$(pwd)/external \
  menuconfig

step3: compelete the menuconfig configuration, save end exit, new configured data is in .config



step4: save defconfig (from .config to defconfig)
make -C ./buildroot \
  O=/mnt/wsl/ramdisk5/out/config_workspace \
  BR2_EXTERNAL=$(pwd)/external \
  BR2_DEFCONFIG=$(pwd)/external/configs/my_qemu_riscv64_DEBUG_defconfig \
  savedefconfig



2. to build:

step1:   load defconfig (Initialize the .config)
make -C buildroot \
  O=/mnt/wsl/ramdisk5/out/my_raw_build \
  BR2_EXTERNAL=$(pwd)/external \
  my_qemu_riscv64_virt_defconfig

step2:
make -C buildroot \
  O=/mnt/wsl/ramdisk5/out/my_raw_build \
  BR2_EXTERNAL=$(pwd)/external


or

cd /mnt/wsl/ramdisk5/out/my_raw_build
make
