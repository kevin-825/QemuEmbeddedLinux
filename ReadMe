QemuEmbeddedLinux/
├── build_env.json                      <-- The master matrix configuration file
├── build_runner.sh                     <-- The modular Bash execution engine
│
├── buildroot/                          <-- Upstream Buildroot (Untouched Git Submodule)
│
├── external/                           <-- Your BR2_EXTERNAL Tree (The actual BSP)
│   ├── external.desc
│   ├── Config.in
│   ├── external.mk
│   ├── configs/                        <-- Base configuration files
│   │   ├── qemu_riscv64_virt_defconfig
│   │   ├── qemu_aarch64_virt_defconfig
│   │   └── raspberrypi3_64_defconfig
│   ├── board/                          <-- Static target files (genimage.cfg, overlays)
│   └── package/                        <-- Buildroot package recipes (.mk and Config.in)
│
├── local_src/                          <-- Active Development Area (The OVERRIDE_SRCDIR targets)
│   ├── linux-riscv64/                  <-- RISC-V kernel bring-up tree
│   ├── linux-aarch64/                  <-- ARM64 kernel bring-up tree
│   ├── u-boot-riscv64/
│   ├── u-boot-aarch64/
│   ├── drivers/
│   │   └── custom_sensor_mod/          <-- Out-of-tree kernel module source code
│   └── apps/
│       └── my_custom_daemon/           <-- Proprietary C/C++ user-space daemon
│
├── scripts/                            <-- Modular Execution Hooks (Run on Host)
│   ├── pre_build.sh                    <-- Validates paths, git branches, or generates headers
│   └── post_build.sh                   <-- Extracts artifacts from out/ and pushes to TFTP
│
└── out/                                <-- Dynamically Generated Build Output (Git-ignored)
    ├── qemu_riscv64_virt_custom_dev_profile/
    │   ├── .config                     <-- The initialized Buildroot configuration
    │   ├── local.mk                    <-- Auto-generated by build_runner.sh to map local_src/
    │   ├── build/                      <-- Where the dev0 container actually compiles code
    │   └── images/                     <-- Final Image, rootfs.cpio, and DTBs
    │
    └── qemu_aarch64_raspi3_full_bsp_profile/
        ├── .config
        ├── local.mk
        └── images/                     <-- Final sdcard.img